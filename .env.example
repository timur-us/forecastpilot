# Copy this file to .env and fill in your key. NEVER commit .env.
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# USD per million tokens, used for the cost_usd estimate on each commentary
# response. Check current pricing at anthropic.com/pricing.
ANTHROPIC_PRICE_INPUT_PER_MTOK=3.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=15.0

# Per-client rate limits on GET /forecast/{ticker} (limits library syntax,
# e.g. "30/hour"). Requests with commentary=true are metered separately
# (and more strictly) since they trigger a paid LLM call.
RATE_LIMIT_FORECAST=30/hour
RATE_LIMIT_COMMENTARY=5/hour

# Cache generated commentary in-process for the rest of the UTC day, keyed
# by (ticker, language, horizon). Set to "false" to always call the LLM.
COMMENTARY_CACHE_ENABLED=true
