# Copy this file to .env and fill in your key. NEVER commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-5-5

# USD per million tokens, used for the cost_usd estimate on each commentary
# response. Defaults match Claude Sonnet 5.5 base input/output pricing, see
# https://platform.claude.com/docs/en/about-claude/pricing. The deploy job in
# .github/workflows/ci.yml sets the same model and prices in production.
ANTHROPIC_PRICE_INPUT_PER_MTOK=2.0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=10.0

# Per-client rate limits on GET /forecast/{ticker} (limits library syntax,
# e.g. "30/hour"). Requests with commentary=true are metered separately
# (and more strictly) since they trigger a paid LLM call.
RATE_LIMIT_FORECAST=30/hour
RATE_LIMIT_COMMENTARY=5/hour

# Networks of trusted reverse proxies (comma-separated CIDRs). Behind Azure
# Container Apps the ingress connects from 100.64.0.0/10 and appends the
# caller's address to X-Forwarded-For; only then is that header used for the
# per-client rate limit. Leave empty when the app is reached directly.
TRUSTED_PROXY_CIDRS=

# Browser origins allowed to call the API (comma-separated, scheme + host, no
# path). Empty = CORS off. Production sets the GitHub Pages origin of the UI.
CORS_ORIGINS=

# Where GET / of the API sends browsers (the web UI).
WEB_UI_URL=https://timur-us.github.io/forecastpilot/

# Cache generated commentary in-process for the rest of the UTC day, keyed
# by (ticker, language, horizon, prompt version) plus the last close and
# forecast start/end the text cites, so a price move yields fresh text. "false" always calls the LLM.
COMMENTARY_CACHE_ENABLED=true
